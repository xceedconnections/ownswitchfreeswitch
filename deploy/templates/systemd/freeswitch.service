# Managed by Ownswitch installer - rendered from deploy/templates/systemd/freeswitch.service
# Only installed when FREESWITCH_ENABLED=1
[Unit]
Description=FreeSWITCH (Ownswitch SIP edge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freeswitch
Group=freeswitch
RuntimeDirectory=freeswitch
RuntimeDirectoryMode=0750
Environment=FREESWITCH_PID=/run/freeswitch/freeswitch.pid
Environment=LD_LIBRARY_PATH=@@FS_PREFIX@@/lib
# "+" = run as root (User= above would otherwise own ExecStartPre and break chown on ownswitch gateway XML).
ExecStartPre=+/bin/mkdir -p @@FS_PREFIX@@/log @@FS_PREFIX@@/db @@FS_PREFIX@@/storage @@FS_PREFIX@@/recordings @@FS_PREFIX@@/sounds
ExecStartPre=+/bin/chown freeswitch:freeswitch @@FS_PREFIX@@/log @@FS_PREFIX@@/db @@FS_PREFIX@@/storage @@FS_PREFIX@@/recordings @@FS_PREFIX@@/sounds
ExecStart=@@FS_PREFIX@@/bin/freeswitch -nc -nf -nonat -conf @@FS_PREFIX@@/conf -db @@FS_PREFIX@@/db -log @@FS_PREFIX@@/log -run /run/freeswitch
ExecReload=/usr/bin/env kill -HUP $MAINPID
TimeoutStartSec=120
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60
LimitNOFILE=100000
LimitCORE=infinity
# Must be large enough for SoftTimer / Sofia threads (240 bytes caused immediate SEGV).
LimitSTACK=250000
LimitNPROC=60000
LimitRTPRIO=infinity
LimitRTTIME=infinity
UMask=0007
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
