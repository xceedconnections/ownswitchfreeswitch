# =============================================================================
# Ownswitch runtime environment  ->  /etc/ownswitch/ownswitch.env  (root:ownswitch, 0640)
# Generated by deploy/stages/90_app_deploy.sh from deploy/templates/ownswitch.env.tpl
# DO NOT EDIT BY HAND and NEVER commit this file: re-running the installer regenerates it.
# Format: plain KEY=VALUE (no quotes, no spaces) so systemd EnvironmentFile= and PHP can both read it.
# =============================================================================

APP_ENV=production
APP_DEBUG=0
APP_URL=https://@@OWNSWITCH_DOMAIN@@
APP_TIMEZONE=UTC
APP_KEY=@@APP_KEY@@
OWNSWITCH_ROOT=@@OWN_OPT@@/current
OWNSWITCH_STORAGE=@@OWN_VAR@@/storage
OWNSWITCH_LOG_DIR=@@OWN_LOG@@
INTERNAL_API_URL=http://@@INTERNAL_HTTP_ADDR@@

# --- Portal database (authoritative business data) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=@@DB_OWNSWITCH@@
DB_USERNAME=ownswitch
DB_PASSWORD=@@MYSQL_OWNSWITCH_PASSWORD@@
# Aliases kept for older tooling
DB_NAME=@@DB_OWNSWITCH@@
DB_USER=ownswitch

# --- OpenSIPS (portal provisions subscriber/address/drouting into this DB) ---
OPENSIPS_ENABLED=1
OPENSIPS_SIP_DOMAIN=@@OWNSWITCH_DOMAIN@@
SIP_PUBLIC_IP=@@PUBLIC_IP@@
OPENSIPS_DB_HOST=127.0.0.1
OPENSIPS_DB_PORT=3306
OPENSIPS_DB_DATABASE=@@DB_OPENSIPS@@
OPENSIPS_DB_USERNAME=opensips
OPENSIPS_DB_PASSWORD=@@MYSQL_OPENSIPS_PASSWORD@@
OPENSIPS_DB_NAME=@@DB_OPENSIPS@@
OPENSIPS_DB_USER=opensips
OPENSIPS_MI_FIFO=@@OPENSIPS_FIFO@@
OPENSIPS_MI_HTTP_URL=@@OPENSIPS_MI_HTTP_URL@@
OPENSIPS_MI_URL=@@OPENSIPS_MI_HTTP_URL@@
OPENSIPS_SIP_PORT=@@SIP_PORT@@

# --- CGRateS (JSON-RPC over loopback only) ---
CGRATES_TENANT=@@CGRATES_TENANT@@
CGRATES_JSONRPC_ADDR=@@CGR_JSONRPC_ADDR@@
CGRATES_HTTP_JSONRPC_URL=http://@@CGR_HTTP_ADDR@@/jsonrpc
CGRATES_BIJSON_ADDR=@@CGR_BIJSON_ADDR@@
# read-only reconciliation access to the CGRateS StorDB
CGRATES_STORDB_HOST=127.0.0.1
CGRATES_STORDB_PORT=3306
CGRATES_STORDB_NAME=@@DB_CGRATES@@
CGRATES_STORDB_RO_USER=cgrates_ro
CGRATES_STORDB_RO_PASSWORD=@@MYSQL_CGRATES_RO_PASSWORD@@

# --- Redis (portal cache only; CGRateS DataDB uses a different index) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=@@REDIS_PASSWORD@@
REDIS_PORTAL_DB=@@REDIS_PORTAL_DB@@

# --- RTPengine / recordings ---
RTPENGINE_NG_URL=udp:127.0.0.1:@@RTPENGINE_NG_PORT@@
RTP_PORT_MIN=@@RTP_PORT_MIN@@
RTP_PORT_MAX=@@RTP_PORT_MAX@@
RECORDINGS_DIR=@@OWN_VAR@@/recordings
RECORDING_NOTIFY_TOKEN=@@RECORDING_NOTIFY_TOKEN@@

# --- FreeSWITCH (SIP edge + ESL) ---
FREESWITCH_ENABLED=@@FREESWITCH_ENABLED@@
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=@@FS_ESL_PASSWORD@@
FS_XML_SECRET=@@FS_XML_SECRET@@
FREESWITCH_CONF=/usr/local/freeswitch/conf
FREESWITCH_GATEWAY_DIR=@@OWN_VAR@@/freeswitch/gateways

# --- Public addressing ---
PUBLIC_IP=@@PUBLIC_IP@@
PRIVATE_IP=@@PRIVATE_IP@@
