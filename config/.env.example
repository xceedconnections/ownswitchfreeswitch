# Copy to config/.env and edit. NEVER commit config/.env.
APP_NAME=Ownswitch
APP_ENV=local
APP_DEBUG=true
# Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
APP_TIMEZONE=UTC

# Portal database (XAMPP defaults; use a least-privilege user in production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ownswitch
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session / cookies. Set SESSION_SECURE=true behind HTTPS.
SESSION_SECURE=false
SESSION_LIFETIME=7200

# Integrations (all optional; the System Status page reports "not configured")
OPENSIPS_ENABLED=false
OPENSIPS_DB_HOST=127.0.0.1
OPENSIPS_DB_PORT=3306
OPENSIPS_DB_DATABASE=opensips
OPENSIPS_DB_USERNAME=
OPENSIPS_DB_PASSWORD=
OPENSIPS_SIP_DOMAIN=sip.example.test
OPENSIPS_MI_URL=http://127.0.0.1:8888/mi

CGRATES_URL=
CGRATES_USER=
CGRATES_PASSWORD=
CGRATES_TENANT=cgrates.org

RTPENGINE_HOST=
RTPENGINE_PORT=22222

FREESWITCH_HOST=
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=

# Recordings are stored OUTSIDE the web root.
RECORDINGS_DIR=
